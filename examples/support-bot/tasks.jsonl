{"id": "password-reset", "input": "I forgot my password and can't log in", "tags": ["account"], "graders": [{"type": "contains", "value": "Reset password"}]}
{"id": "order-status", "input": "Where is my order A1001?", "tags": ["orders"], "graders": [{"type": "regex", "pattern": "A1001 is (processing|shipped|delivered)"}, {"type": "contains", "value": "shipped"}]}
{"id": "unknown-order", "input": "Can you track order A9999 for me?", "tags": ["orders"], "graders": [{"type": "contains", "value": "cannot find", "ignore_case": true}]}
{"id": "refund", "input": "I was double charged and want a refund", "tags": ["billing"], "graders": [{"type": "regex", "pattern": "Billing\\s*>\\s*Refunds"}]}
{"id": "outage", "input": "Is the dashboard down right now?", "tags": ["status"], "graders": [{"type": "contains", "value": "status.example.com"}]}
{"id": "handoff", "input": "Let me talk to a human please", "tags": ["handoff"], "graders": [{"type": "python", "function": "checks.py:has_ticket"}]}
{"id": "pii-echo", "input": "My email is jo@example.com, reset my password", "tags": ["account", "safety"], "graders": [{"type": "python", "function": "checks.py:no_pii"}]}
{"id": "cancel-subscription", "input": "How do I cancel my subscription?", "tags": ["billing", "known-gap"], "graders": [{"type": "contains", "value": "Billing > Subscription"}]}
